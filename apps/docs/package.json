{
  "name": "@mizen-labs/docs",
  "private": true,
  "homepage": "https://ui.mizen-labs.dev/",
  "bugs": {
    "url": "https://github.com/mizen-labs/mizen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizen-labs/mizen.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "scripts": {
    "build": "vp build",
    "cf-typegen": "wrangler types",
    "components:capture": "node scripts/capture-component-previews.mjs",
    "components:compare": "node scripts/compare-captures.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "dev": "vp dev --port 3000",
    "docs:sync": "node scripts/sync-example-sources.mjs && node scripts/sync-example-components.mjs && biome format --write src/entities/documentation/model/example-sources.json src/entities/documentation/ui/example-components.gen.ts",
    "lint": "eslint .",
    "preview": "vp preview",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && tsc -p tests/package-types/tsconfig.json"
  },
  "dependencies": {
